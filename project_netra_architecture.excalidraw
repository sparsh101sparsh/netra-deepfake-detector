    {
      "id": "e0c6d5b1",
      "type": "text",
      "x": 7934,
      "y": 1210,
      "width": 689,
      "height": 27,
      "angle": 0,
      "strokeColor": "#60a5fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 789342,
      "version": 1,
      "versionNonce": 234646,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Paired Supervised Contrastive Loss (PairedSupConLoss)",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
      "containerId": null,
      "originalText": "Paired Supervised Contrastive Loss (PairedSupConLoss)",
      "lineHeight": 1.25
    },
    {
      "id": "8ab53b7c",
      "type": "text",
      "x": 7934,
      "y": 1250,
      "width": 1209,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f1f5f9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 680251,
      "version": 1,
      "versionNonce": 45361,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 \u2022 Standard Cross-Entropy causes models to memorize identity shortcuts (e.g. Narendra Modi's beard or Rahul Gandhi's hair).",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 \u2022 Standard Cross-Entropy causes models to memorize identity shortcuts (e.g. Narendra Modi's beard or Rahul Gandhi's hair).",
      "lineHeight": 1.25
    },
    {
      "id": "6fa6b50e",
      "type": "text",
      "x": 7934,
      "y": 1282,
      "width": 1160,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f1f5f9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 746392,
      "version": 1,
      "versionNonce": 664354,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 \u2022 PairedSupConLoss trains on paired batches: (Authentic Image x_i, SBI Synthetic Swap x_i') of the EXACT SAME PERSON.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 \u2022 PairedSupConLoss trains on paired batches: (Authentic Image x_i, SBI Synthetic Swap x_i') of the EXACT SAME PERSON.",
      "lineHeight": 1.25
    },
    {
      "id": "7c424582",
      "type": "text",
      "x": 7934,
      "y": 1314,
      "width": 1131,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f1f5f9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 839046,
      "version": 1,
      "versionNonce": 463061,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 \u2022 Loss pulls Real features together and pushes Fake swap of the same face apart in hyperspherical embedding space.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 \u2022 Loss pulls Real features together and pushes Fake swap of the same face apart in hyperspherical embedding space.",
      "lineHeight": 1.25
    },
    {
      "id": "e5e43a49",
      "type": "text",
      "x": 7934,
      "y": 1346,
      "width": 858,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f1f5f9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 484350,
      "version": 1,
      "versionNonce": 748204,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 \u2022 Formula: L_total = L_CE(z, y; smoothing=0.05) + 0.30 * L_SupCon(x\u0302, y, identity_id).",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 \u2022 Formula: L_total = L_CE(z, y; smoothing=0.05) + 0.30 * L_SupCon(x\u0302, y, identity_id).",
      "lineHeight": 1.25
    },
    {
      "id": "608cb3b1",
      "type": "text",
      "x": 7934,
      "y": 1378,
      "width": 897,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f1f5f9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 845298,
      "version": 1,
      "versionNonce": 426765,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 \u2022 Result: Model learns purely MANIPULATION RESIDUALS with zero identity memorization bias.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 \u2022 Result: Model learns purely MANIPULATION RESIDUALS with zero identity memorization bias.",
      "lineHeight": 1.25
    },
