    },
    {
      "id": "5b6f5e5b",
      "type": "text",
      "x": 5100,
      "y": 1060,
      "width": 347,
      "height": 228,
      "angle": 0,
      "strokeColor": "#94a3b8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 921659,
      "version": 1,
      "versionNonce": 595916,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "GAN Architecture:\n\n Generator learns to reconstruct\n high-frequency facial texture\n by fooling a Discriminator.\n\n The Discriminator asks:\n 'Is this a real face crop?'\n Generator keeps improving\n until the Discriminator\n can no longer tell the difference.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "GAN Architecture:\n\n Generator learns to reconstruct\n high-frequency facial texture\n by fooling a Discriminator.\n\n The Discriminator asks:\n 'Is this a real face crop?'\n Generator keeps improving\n until the Discriminator\n can no longer tell the difference.",
      "lineHeight": 1.25
    },
