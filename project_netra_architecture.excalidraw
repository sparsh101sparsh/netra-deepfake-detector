      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Step 1: Feature Vector L2 Normalization: x\u0302 = x / (||x|| + 1e-7).",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 Step 1: Feature Vector L2 Normalization: x\u0302 = x / (||x|| + 1e-7).",
      "lineHeight": 1.25
    },
    {
      "id": "02c4d642",
      "type": "text",
      "x": 8994,
      "y": 844,
      "width": 721,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f1f5f9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 960661,
      "version": 1,
      "versionNonce": 916662,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Step 2: Prototype Weight L2 Normalization: \u0175_k = w_k / (||w_k|| + 1e-7).",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 Step 2: Prototype Weight L2 Normalization: \u0175_k = w_k / (||w_k|| + 1e-7).",
      "lineHeight": 1.25
    },
    {
      "id": "064dcfe0",
      "type": "text",
      "x": 8994,
      "y": 876,
      "width": 819,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f1f5f9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 681844,
      "version": 1,
      "versionNonce": 769524,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Step 3: Temperature-Scaled Cosine Logits: logit_k = cos(\u03b8_k) / \u03c4 (where \u03c4 = 0.07).",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 Step 3: Temperature-Scaled Cosine Logits: logit_k = cos(\u03b8_k) / \u03c4 (where \u03c4 = 0.07).",
      "lineHeight": 1.25
    },
