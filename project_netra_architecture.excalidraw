      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 API Gateway (t3.micro): Always on \u2192 Only $0.04/hr\n\u2022 GPU Worker (Spot g4dn): Only runs when video submitted\n\u2022 Zero idle GPU cost! Model only loaded on-demand.\n\u2022 10-second video full scan: < $0.002 compute cost!",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "\u2022 API Gateway (t3.micro): Always on \u2192 Only $0.04/hr\n\u2022 GPU Worker (Spot g4dn): Only runs when video submitted\n\u2022 Zero idle GPU cost! Model only loaded on-demand.\n\u2022 10-second video full scan: < $0.002 compute cost!",
      "lineHeight": 1.25
    },
