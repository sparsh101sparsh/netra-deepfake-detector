      "text": "GatedFusionEngine Multi-Modal Weighted Logic",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
      "containerId": null,
      "originalText": "GatedFusionEngine Multi-Modal Weighted Logic",
      "lineHeight": 1.25
    },
    {
      "id": "9911a966",
      "type": "text",
      "x": 284,
      "y": 3170,
      "width": 1092,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f1f5f9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 121655,
      "version": 1,
      "versionNonce": 887187,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 \u2022 Rule-based weighted fusion formula: Visual_Effective = 0.60 * GenD + 0.25 * Spatial_SBI + 0.15 * CLIP_Probe.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 \u2022 Rule-based weighted fusion formula: Visual_Effective = 0.60 * GenD + 0.25 * Spatial_SBI + 0.15 * CLIP_Probe.",
      "lineHeight": 1.25
    },
    {
      "id": "61875816",
      "type": "text",
      "x": 284,
      "y": 3202,
      "width": 1111,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f1f5f9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 684711,
      "version": 1,
      "versionNonce": 418596,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 \u2022 Audio Gate: If audio is silent or ambient noise (audio_score < 0.30), dynamically reduce audio weight to 0.10.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 \u2022 Audio Gate: If audio is silent or ambient noise (audio_score < 0.30), dynamically reduce audio weight to 0.10.",
      "lineHeight": 1.25
    },
    {
      "id": "3d144381",
      "type": "text",
      "x": 284,
      "y": 3234,
      "width": 1082,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f1f5f9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 292863,
      "version": 1,
      "versionNonce": 548418,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 \u2022 Multi-Modal Synthesis: Final_Score = 0.65 * Visual_Effective + 0.25 * Audio_Score + 0.10 * Auxiliary_Flags.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 \u2022 Multi-Modal Synthesis: Final_Score = 0.65 * Visual_Effective + 0.25 * Audio_Score + 0.10 * Auxiliary_Flags.",
      "lineHeight": 1.25
    },
