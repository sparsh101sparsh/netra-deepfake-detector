# ── AWS Core ──────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=<your-aws-account-id>
AWS_ACCESS_KEY_ID=<from ~/.aws/credentials>
AWS_SECRET_ACCESS_KEY=<from ~/.aws/credentials>

# ── S3 Buckets ────────────────────────────────────────────────
S3_BUCKET_MEDIA=netra-media-uploads
S3_BUCKET_MODELS=netra-models
S3_BUCKET_DATASETS=netra-datasets
S3_BUCKET_REPORTS=netra-reports

# ── SQS ───────────────────────────────────────────────────────
SQS_QUEUE_URL=<set after running infra/bootstrap_aws.py>

# ── DynamoDB ──────────────────────────────────────────────────
DYNAMO_TABLE_JOBS=netra-jobs
DYNAMO_TABLE_RATELIMITS=netra-rate-limits

# ── ECR ───────────────────────────────────────────────────────
ECR_REPO_API=<aws-account-id>.dkr.ecr.us-east-1.amazonaws.com/netra-api
ECR_REPO_WORKER=<aws-account-id>.dkr.ecr.us-east-1.amazonaws.com/netra-worker

# ── Amazon Bedrock ────────────────────────────────────────────
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_REGION=us-east-1

# ── ML Models ─────────────────────────────────────────────────
# Paths on EC2 worker after downloading from HuggingFace:
SPATIAL_MODEL_PATH=/opt/netra/models/spatial/model.pth
CLIP_PROBE_PATH=/opt/netra/models/clip_probe/model.pth
# HuggingFace model IDs (after Kaggle training uploads them):
SPATIAL_HF_MODEL_ID=netra-ai/spatial-detector-v1
AUDIO_HF_MODEL=MelodyMachine/Deepfake-audio-detection-V2

# ── HuggingFace ───────────────────────────────────────────────
HF_TOKEN=<your-huggingface-token>

# ── WandB (optional for training monitoring) ──────────────────
WANDB_API_KEY=<your-wandb-api-key>
WANDB_PROJECT=netra-v5

# ── Kaggle ────────────────────────────────────────────────────
KAGGLE_USERNAME=sparshsingh989
KAGGLE_API_TOKEN=<your-kaggle-api-token>

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://<EC2-PUBLIC-IP>:8000

# ── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<BotFather token>
TELEGRAM_WEBHOOK_URL=https://<EC2-IP>/webhook/telegram

# ── WhatsApp Bot (Twilio) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=<Twilio SID>
TWILIO_AUTH_TOKEN=<Twilio token>
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
