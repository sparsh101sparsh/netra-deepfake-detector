FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

WORKDIR /app

# Install system dependencies (FFmpeg, OpenCV requirements)
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3-pip \
    python3.11-dev \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    cmake \
    build-essential \
    libboost-all-dev \
    && rm -rf /var/lib/apt/lists/*

# Symlink python3.11 as python3
RUN ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    ln -sf /usr/bin/pip3 /usr/bin/pip

# Install PyTorch with CUDA support first (big layer — cache separately)
RUN pip install --no-cache-dir \
    torch==2.3.0+cu121 \
    torchvision==0.18.0+cu121 \
    --index-url https://download.pytorch.org/whl/cu121

# Copy and install remaining requirements (build context = project root)
COPY worker/requirements-worker.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy worker code and netra pipeline
COPY worker/worker.py .
COPY backend/netra/ ./netra/

# Create model cache directory
RUN mkdir -p /opt/netra/models/spatial /opt/netra/models/clip /opt/netra/models/audio

# Health check
HEALTHCHECK --interval=60s --timeout=30s --start-period=60s --retries=3 \
    CMD python3 -c "import torch; print('OK')"

# Run the SQS worker
CMD ["python3", "worker.py"]
